[Unit]
Description=Magnitude 专用的第二个 dockerd（独立 data-root，不碰主 daemon）
Documentation=https://magnitude.dev
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=notify
# Separate data-root / exec-root / socket, iptables off, no bridge, only runs the magnitude container.
# daemon.json is generated by scripts/llm-magnitude.sh; __DATA__ is substituted by install-units.sh.
ExecStart=/usr/bin/dockerd --config-file __DATA__/magnitude-data/daemon.json
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutStartSec=180
Restart=on-failure
RestartSec=5
LimitNOFILE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
