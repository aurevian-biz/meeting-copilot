[Unit]
Description=Magnitude 推理服务（Qwen3.5-35B-A3B，OpenAI 兼容 10100）
Documentation=https://magnitude.dev
After=magnitude-dockerd.service network-online.target
Wants=magnitude-dockerd.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/meeting-copilot/env
# 起容器 + 等 health + 等 35B Ready。冷启动含 22.9G 权重加载，约 3 分钟
ExecStart=/usr/local/bin/magnitude-up.sh
TimeoutStartSec=600
# 停的时候把模型卸掉释放内存，再停容器；不删容器，下次 start 很快
# 注意：这里不写 ${MC_DATA}。systemd 只做变量替换、不认 shell 的 ${VAR:-默认}，
# 所以路径写死成安装脚本创建的标准位置；数据盘换地方就改这一行。
ExecStop=/bin/bash -c 'DOCKER_HOST=unix:///opt/meeting-copilot/data/magnitude-data/docker.sock /usr/bin/docker stop magnitude-bench || true'

[Install]
WantedBy=multi-user.target
