[Unit]
Description=Magnitude 推理服务（Qwen3.5-35B-A3B，OpenAI 兼容 10100）
Documentation=https://magnitude.dev
After=magnitude-dockerd.service network-online.target
Wants=magnitude-dockerd.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/meeting-copilot/env
# Start the container + wait for health + wait for 35B Ready. Cold start includes loading 22.9G of weights, ~3 minutes
ExecStart=/usr/local/bin/magnitude-up.sh
TimeoutStartSec=600
# On stop, unload the model to free memory, then stop the container; the container is kept, so the next start is quick
# Note: ${MC_DATA} is not used here. systemd only substitutes variables and does not understand shell ${VAR:-default};
# so install-units.sh replaces __DATA__ with the real data root.
ExecStop=/bin/bash -c 'DOCKER_HOST=unix://__DATA__/magnitude-data/docker.sock /usr/bin/docker stop magnitude-bench || true'

[Install]
WantedBy=multi-user.target
