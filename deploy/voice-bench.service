# /etc/systemd/system/voice-bench.service
#
# Voice assistant: wake word -> ASR -> LLM -> TTS; open 8095 in a browser and talk to the box.
#
# The LLM defaults to Magnitude's 35B-A3B (10100) rather than vLLM's 7B (8000). Why the switch:
#   · Quality: with this Japanese system prompt + Chinese replies, the 7B emits mixed
#     Chinese/Japanese like "会議的时间确认 needed." and stray -topic1- / Spanish words; 35B never does
#   · Full answer: 25~35% faster on long answers (screen reading, summaries); MoE decoding activates only 3B
#   · First token: 170~370ms slower (~250ms extra on a ~45-character opening line), accepted
#   · Language: the assistant must do "Japanese meeting, Chinese playback", via --reply-lang zh; the directive
#     goes at the end of the user message (voice_server._lang_directive), only then does 35B obey (0/6 on system, 6/6 on user)
#
# Roll back to 7B: change --llm-* to `--llm-model qwen` (base defaults to 8000),
# and make sure the vLLM container is running (docker start vllm-qwen).
[Unit]
Description=Voice bench (SenseVoice ASR + LLM 35B-A3B + Piper TTS, web UI on 8095)
Documentation=https://github.com/__GH_REPO__
After=network-online.target sound.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME__
EnvironmentFile=-/etc/meeting-copilot/env
Environment=PYTHONUNBUFFERED=1
Environment=PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
# Local playback goes through pw-play, which must reach the user session's PipeWire
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
ExecStart=__HOME__/.venv/bin/python __HOME__/voice_server.py \
    --port 8095 --reply-lang zh \
    --llm-base ${LLM_BASE} --llm-model "${LLM_MODEL}" --llm-key ${LLM_KEY} \
    --local-speak --local-sink ${MC_SINK} \
    --vision-trt ${MC_DATA}/models/rec_fp16.engine
Restart=always
RestartSec=3
PrivateTmp=no

[Install]
WantedBy=multi-user.target
